# 서버에서 이 파일을 .env 로 복사해 값을 채우세요 (cp deploy.env.example .env). .env 는 git 에 올리지 않습니다.

# [Cloudflare Tunnel 방식 — docker-compose.tunnel.yml] 새로 만든 터널의 토큰 (비밀값, 채팅·git 에 올리지 말 것)
TUNNEL_TOKEN=

# [공인 IP 서버 방식 — docker-compose.yml + Caddy] 연결할 도메인 (DNS A 레코드가 이 서버 IP 를 가리켜야 인증서 발급)
DOMAIN=

# 접속 비밀번호 (둘 다 넣으면 켜짐). 공개 서버라면 꼭 넣으세요 — IBM 호출 남용과 화면 중계 위조를 막습니다
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# IBM watsonx Orchestrate (비우면 MOCK 모드). NEXT_PUBLIC_ 을 붙이지 마세요
WXO_ENDPOINT_URL=
WXO_API_KEY=
WXO_AGENT_NAME=
WXO_AGENT_ID=
MOCK=0
