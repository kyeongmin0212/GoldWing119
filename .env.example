# 서버 전용 값입니다. NEXT_PUBLIC_ 을 붙이지 마세요 (브라우저에 키가 노출됩니다).
# 이 파일을 .env.local 로 복사해 값을 채우면 LIVE 모드, 비워 두면 MOCK 모드로 동작합니다.

# Orchestrate 설정 → API details → 서비스 인스턴스 URL (us-south)
WXO_ENDPOINT_URL=
WXO_API_KEY=
# 둘 중 하나: 에이전트 이름(조회해서 id로 바꿈) 또는 id
WXO_AGENT_NAME=
WXO_AGENT_ID=

# 1 이면 키가 있어도 강제로 MOCK 모드
MOCK=0
